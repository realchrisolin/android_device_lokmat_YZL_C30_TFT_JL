# Recovery mount table for YZL_C30_TFT_JL.
# Filesystem types match the running system on 2026-10-02.
# Stock first-stage fstab also carries AVB flags. Those are omitted here so a
# recovery ramdisk can mount the logical partitions without re-verifying vbmeta.
# Radio-identity partitions (nvram, nvdata, nvcfg, proinfo, protect1, protect2,
# otp, seccfg, modem) are not listed.

# Logical images inside super. Live mounts are erofs. The ext4 lines are the
# stock fstab's fallback and are not the images on this unit today.

system /system erofs ro wait,slotselect,logical
system /system ext4 ro wait,slotselect,logical

system_ext /system_ext erofs ro wait,slotselect,logical
system_ext /system_ext ext4 ro wait,slotselect,logical

vendor /vendor erofs ro wait,slotselect,logical
vendor /vendor ext4 ro wait,slotselect,logical

product /product erofs ro wait,slotselect,logical
product /product ext4 ro wait,slotselect,logical

vendor_dlkm /vendor_dlkm erofs ro wait,slotselect,logical
vendor_dlkm /vendor_dlkm ext4 ro wait,slotselect,logical

odm_dlkm /odm_dlkm erofs ro wait,slotselect,logical
odm_dlkm /odm_dlkm ext4 ro wait,slotselect,logical

system_dlkm /system_dlkm erofs ro wait,slotselect,logical
system_dlkm /system_dlkm ext4 ro wait,slotselect,logical

# metadata is mmcblk0p12, f2fs. userdata is f2fs through a dm device, with
# fileencryption v2 and metadata encryption. reserve_root matches the live mount.

/dev/block/by-name/metadata /metadata f2fs noatime,nosuid,nodev,discard wait,check,formattable,first_stage_mount

/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt wait,check,formattable,quota,latemount,resize,readahead_size_kb=512,reservedsize=128m,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption

# Stock vold lines. The eMMC boot device is 11230000.mmc. 11240000.mmc is the
# fstab's external-card controller and may not be populated on this watch.

/devices/platform/11240000.mmc* auto auto defaults voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/mt_usb* auto vfat defaults voldmanaged=usbotg:auto
